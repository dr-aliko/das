{% load static %}{
  "name": "Vagus",
  "short_name": "Vagus",
  "description": "Smarter exam analytics for serious students. Track every exam. Master every topic.",
  "lang": "tr",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "theme_color": "#121623",
  "background_color": "#0B0E16",
  "icons": [
    { "src": "{% static 'vagus/pwa/icon-192.png' %}",          "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "{% static 'vagus/pwa/icon-512.png' %}",          "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "{% static 'vagus/pwa/icon-maskable-192.png' %}", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "{% static 'vagus/pwa/icon-maskable-512.png' %}", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
